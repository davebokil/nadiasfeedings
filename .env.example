# Firebase web app config (Project settings → Your apps → Web app → SDK setup and configuration).
# These are public identifiers, not secrets — security comes from firestore.rules.
NUXT_PUBLIC_FIREBASE_API_KEY=
NUXT_PUBLIC_FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
NUXT_PUBLIC_FIREBASE_PROJECT_ID=your-project
NUXT_PUBLIC_FIREBASE_APP_ID=

# Google accounts allowed to read/write (comma-separated). Used only by `npm run deploy:rules`,
# which writes them into the git-ignored firestore.deploy.rules. Never put them in firestore.rules.
ALLOWED_EMAILS=you@gmail.com,spouse@gmail.com

# Only for scripts/import.mjs and scripts/backup.mjs (never commit the key file)
GOOGLE_APPLICATION_CREDENTIALS=./service-account.json
